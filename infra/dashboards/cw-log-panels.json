  },
  {
    "id": 172,
    "type": "logs",
    "title": "[API] Recent logs",
    "datasource": { "type": "cloudwatch", "uid": "${DS_CW}" },
    "gridPos": { "h": 8, "w": 12, "x": 0, "y": 98 },
    "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
    "targets": [
      {
        "refId": "A",
        "datasource": { "type": "cloudwatch", "uid": "${DS_CW}" },
        "queryMode": "Logs",
        "region": "default",
        "logGroupNames": ["/ecs/powersync-api"],
        "expression": "fields @timestamp, @message | sort @timestamp desc | limit 100",
        "statsGroups": []
      }
    ]
  },
