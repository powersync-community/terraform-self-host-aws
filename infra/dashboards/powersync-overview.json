    {
      "type": "stat",
      "title": "Successful compactions (range)",
      "id": 60,
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CW}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 74
      },
      "description": "**What it shows:** How many compaction runs finished successfully in the selected time range. Compaction removes old operations from bucket storage. It runs every day at 02:00 UTC.\n\n**Healthy:** About one for each day in the range.\n\n**If not:** 0 over several days means compaction does not run or fails. Check the Compaction logs panel and Scheduled-run launch failures. See [Compacting buckets](https://docs.powersync.com/maintenance-ops/compacting-buckets).",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CW}"
          },
          "queryMode": "Logs",
          "region": "default",
          "logGroupNames": [
            "/ecs/powersync-compact"
          ],
          "expression": "filter @message like /Successfully compacted/ | stats count() as successes",
          "statsGroups": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Scheduled-run launch failures (range)",
