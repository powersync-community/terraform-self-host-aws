{
  "title": "PowerSync: Self-Hosted Overview",
  "uid": "powersync-self-hosted-overview",
  "tags": [
    "powersync",
    "observability"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "",
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "builtIn": 1,
        "type": "dashboard",
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "label": "AMP (Prometheus)",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "DS_CW",
        "label": "CloudWatch",
        "type": "datasource",
        "query": "cloudwatch",
        "current": {},
        "hide": 0
      },
      {
        "name": "DS_OS",
        "label": "OpenSearch",
        "type": "datasource",
        "query": "elasticsearch",
        "current": {},
        "hide": 0
      },
      {
        "name": "cluster",
        "label": "PowerSync cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "query": "label_values(powersync_concurrent_connections, cluster)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "query": "debug,info,warn,error,fatal",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "ecs_cluster",
        "label": "ECS cluster name",
        "type": "constant",
        "query": "powersync-cluster",
        "current": {
          "text": "powersync-cluster",
          "value": "powersync-cluster"
        },
        "hide": 2
      },
      {
        "name": "api_service",
        "label": "API ECS service",
        "type": "constant",
        "query": "powersync-api",
        "current": {
          "text": "powersync-api",
          "value": "powersync-api"
        },
        "hide": 2
      },
      {
        "name": "repl_service",
        "label": "Replication ECS service",
        "type": "constant",
        "query": "powersync-replication",
        "current": {
          "text": "powersync-replication",
          "value": "powersync-replication"
        },
        "hide": 2
      },
      {
        "name": "alb",
        "label": "Load balancer",
        "description": "Auto-discovered ALB LoadBalancer dimension value.",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${DS_CW}"
        },
        "query": "dimension_values(us-east-1,AWS/ApplicationELB,RequestCount,LoadBalancer)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "targetgroup",
        "label": "Target group",
        "description": "Auto-discovered ALB TargetGroup dimension value (needed for HealthyHostCount).",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${DS_CW}"
        },
        "query": "dimension_values(us-east-1,AWS/ApplicationELB,HealthyHostCount,TargetGroup)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Service health (SLOs)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Replication lag (now)",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(powersync_replication_lag_seconds{cluster=~\"$cluster\"})"
        }
      ],
      "description": "Current replication lag, how far behind the source database the replicator is. Green <30s, amber 30–60s, red >60s. The single most important sync-health signal."
    },
    {
      "type": "stat",
      "title": "Replicator up",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count(powersync_replication_lag_seconds{cluster=~\"$cluster\"}) > bool 0)"
        }
      ],
      "description": "Whether the replicator is running and reporting metrics. DOWN means no active replication, so nothing syncs to clients."
    },
    {
      "type": "stat",
      "title": "API healthy hosts",
      "id": 12,
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CW}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "region": "default",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HealthyHostCount",
          "statistic": "Minimum",
          "dimensions": {
            "LoadBalancer": "$alb",
            "TargetGroup": "$targetgroup"
          },
          "metricQueryType": 0,
          "metricEditorMode": 0
        }
      ],
      "description": "API targets the ALB considers healthy (per target group). Should equal the running API task count; 0 means clients can't reach the sync API."
    },
    {
      "type": "stat",
      "title": "Concurrent connections",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(powersync_concurrent_connections{cluster=~\"$cluster\"})"
        }
      ],
      "description": "Live client sync connections across all API tasks (powersync_concurrent_connections). This metric also drives API autoscaling."
    },
    {
      "type": "stat",
      "title": "Ops synced / s",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(powersync_operations_synced_total{cluster=~\"$cluster\"}[5m]))"
        }
      ],
      "description": "Rate of sync operations sent to clients (rate of powersync_operations_synced_total). 'No data' at idle is normal, it means no client traffic."
    },
    {
      "type": "stat",
      "title": "API 5xx rate",
      "id": 15,
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CW}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "region": "default",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "statistic": "Sum",
          "dimensions": {
            "LoadBalancer": "$alb"
          },
          "metricQueryType": 0,
          "metricEditorMode": 0
        }
      ],
      "description": "ALB target 5xx responses, server-side errors reaching clients. Should stay at 0."
    },
    {
      "type": "row",
      "title": "Replication pipeline",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Replication lag",
      "id": 20,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance_id) (powersync_replication_lag_seconds{cluster=~\"$cluster\"})",
          "legendFormat": "{{instance_id}}"
        }
      ],
      "description": "Replication lag over time, per instance. Sustained growth means the replicator is falling behind the source database."
    },
    {
      "type": "timeseries",
      "title": "Replicated / s (rows · transactions · chunks)",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(powersync_rows_replicated_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "rows/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(powersync_transactions_replicated_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "transactions/s"
        },
        {
          "refId": "C",
          "expr": "sum(rate(powersync_chunks_replicated_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "chunks/s"
        }
      ],
      "description": "Throughput pulled from the source per second: rows, transactions, and replication chunks. Flatlining while the source is being written indicates a stall."
    },
    {
      "type": "timeseries",
      "title": "Data replicated (bytes/s)",
      "id": 22,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(powersync_data_replicated_bytes_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "replicated"
        }
      ],
      "description": "Uncompressed bytes read from the source and replicated into bucket storage, per second."
    },
    {
      "type": "timeseries",
      "title": "Replicator restarts (Starting Replication Engine)",
      "id": 23,
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CW}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CW}"
          },
          "queryMode": "Logs",
          "region": "default",
          "logGroupNames": [
            "/ecs/powersync-replication"
          ],
          "expression": "filter @message like /Starting Replication Engine/ | stats count() as restarts by bin(1h)",
          "statsGroups": []
        }
      ],
      "description": "Count of 'Starting Replication Engine' log lines, each marks a replicator (re)start. Frequent restarts indicate crash-looping."
    },
    {
      "type": "row",
      "title": "Client sync / API",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Concurrent connections",
      "id": 30,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(powersync_concurrent_connections{cluster=~\"$cluster\"})",
          "legendFormat": "connections"
        }
      ],
      "description": "Active client sync connections over time (summed across API tasks)."
    },
    {
      "type": "timeseries",
      "title": "Sync throughput (ops/s · bytes/s)",
      "id": 31,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "data synced/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ops synced/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(powersync_operations_synced_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "ops synced/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(powersync_data_synced_bytes_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "data synced/s"
        }
      ],
      "description": "Operations and uncompressed bytes synced to clients per second."
    },
    {
      "type": "timeseries",
      "title": "Compression ratio (sent / synced)",
      "id": 32,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "powersync:compression:ratio5m{cluster=~\"$cluster\"}",
          "legendFormat": "compression ratio"
        }
      ],
      "description": "Bytes sent to clients ÷ uncompressed bytes synced (AMP recording rule). Lower is better wire compression."
    },
    {
      "type": "timeseries",
      "title": "Bytes per connection",
      "id": 33,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "powersync:bytes_per_conn:5m{cluster=~\"$cluster\"}",
          "legendFormat": "bytes/conn"
        }
      ],
      "description": "Uncompressed sync bytes per active connection (recording rule). Spikes point to heavy per-client buckets."
    },
    {
      "type": "timeseries",
      "title": "Ops per row (fan-out)",
      "id": 34,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "powersync:ops_per_row:5m{cluster=~\"$cluster\"}",
          "legendFormat": "ops/row"
        }
      ],
      "description": "Operations synced ÷ rows replicated (recording rule). High fan-out means one source row reaches many clients/buckets, often over-broad sync rules."
    },
    {
      "type": "row",
      "title": "Storage & capacity",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Storage size (stacked)",
      "id": 40,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 40,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(powersync_replication_storage_size_bytes{cluster=~\"$cluster\"})",
          "legendFormat": "replication"
        },
        {
          "refId": "B",
          "expr": "sum(powersync_operation_storage_size_bytes{cluster=~\"$cluster\"})",
          "legendFormat": "operations"
        },
        {
          "refId": "C",
          "expr": "sum(powersync_parameter_storage_size_bytes{cluster=~\"$cluster\"})",
          "legendFormat": "parameters"
        }
      ],
      "description": "Bucket storage size split by replication / operation / parameter data. Watch the total trend for capacity planning."
    },
    {
      "type": "timeseries",
      "title": "Parameter-storage bloat ratio",
      "id": 41,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "powersync:param_bloat:ratio{cluster=~\"$cluster\"}",
          "legendFormat": "param / data"
        }
      ],
      "description": "Parameter storage ÷ (replication + operation storage), a recording rule. A high or growing ratio precedes checksum timeouts (PSYNC_S2403)."
    },
    {
      "type": "row",
      "title": "Infrastructure (ECS / ALB)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "ECS CPU utilization",
      "id": 50,
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CW}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 49
