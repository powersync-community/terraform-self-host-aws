{
  "name": "example-client",
  "private": true,
  "type": "module",
  "description": "Seeding + token + a minimal client to exercise the self-hosted PowerSync deployment end-to-end.",
  "scripts": {
    "bootstrap": "tsx bootstrap-db.ts",
    "seed": "tsx seed/seed.ts",
    "clear": "tsx seed/clear.ts",
    "token": "tsx auth/mint-token.ts",
    "dev": "npm run token && npm run dev --prefix web",
    "test:least-privilege": "tsx test-least-privilege.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "jose": "^6.1.3",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
