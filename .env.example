# Copy to .env and fill in, then load it (direnv, or: set -a; source .env; set +a).
# Terraform automatically reads TF_VAR_<name> for each input variable.

# --- AWS auth ---
# Any credential source the AWS CLI/SDK understands works; a named SSO profile is one option.
AWS_PROFILE="your-aws-profile"

# --- Account / DNS identity ---
TF_VAR_account_id="<your_aws_account_id>"       # a guard aborts if your creds resolve elsewhere
TF_VAR_base_domain="example.com"                # you own its Route 53 zone; ALB is <deployment_name>.<base_domain>
TF_VAR_route53_zone_id="<hosted_zone_id>"       # the zone that owns base_domain

# Short unique name for THIS deployment (prefixes every resource; also the subdomain). Has a
# default of "powersync" in variables.tf; override to run more than one deployment in the account.
# TF_VAR_deployment_name="demo"

# CIDRs allowed to reach RDS on 5432 in addition to the ECS tasks — set your workstation IP to
# seed / run the example client locally. TF_VAR list values are JSON:
TF_VAR_admin_cidr='["203.0.113.4/32"]'

# Optional IAM permissions boundary required on every created role. Leave empty if not required.
TF_VAR_iam_permissions_boundary=""

# --- PowerSync admin/management API ---
# Bearer token accepted by the admin API. Leave empty to disable. e.g. openssl rand -hex 32
TF_VAR_admin_api_token=""

# --- Observability (only needed when enable_observability = true in locals.tf) ---
# IAM Identity Center user ID granted Grafana ADMIN. Empty = assign users in the AMG console.
TF_VAR_grafana_admin_user_id=""

# --- Alert forwarding (optional) ---
# Where alerts go in addition to the durable CloudWatch log: log | slack | webhook.
TF_VAR_alert_destination="log"
TF_VAR_alert_webhook_url="<https://hooks.slack.com/services/... or generic webhook URL>"

# --- MongoDB Atlas (ONLY if you switch the data layer to the commented Atlas example) ---
# TF_VAR_atlas_client_id="<atlas_sa_client_id>"
# TF_VAR_atlas_client_secret="<atlas_sa_client_secret>"
# TF_VAR_atlas_project_id="<atlas_project_id>"
